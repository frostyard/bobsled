# Model overrides are optional; the defaults are documented in README.md.
BOBSLED_CODEX_MODEL=gpt-5.6-sol
BOBSLED_COPILOT_MODEL=claude-sonnet-4.6
BOBSLED_TRIAGE_MODEL=gpt-5.6-terra
BOBSLED_WORKER_MODEL=gpt-5.6-sol

# Explicit paths override the cross-platform local defaults.
# BOBSLED_AUTH_FILE=/path/outside/the/repository/auth.json
# BOBSLED_DATA_DIR=/path/outside/the/repository/data
# BOBSLED_WORKSPACE_DIR=/path/outside/the/repository/workspaces
# BOBSLED_CLIX_SOURCE_PATH=/path/to/a/local/clix/checkout

# GitHub integration is disabled until every value required by a mode is set.
# BOBSLED_GITHUB_APP_ID=
# BOBSLED_GITHUB_INSTALLATION_ID=
# Prefer a protected PEM file in deployed environments. Inline key text remains a compatibility fallback.
# BOBSLED_GITHUB_PRIVATE_KEY_FILE=/path/outside/the/repository/github-app.pem
# BOBSLED_GITHUB_PRIVATE_KEY=
# BOBSLED_GITHUB_WEBHOOK_SECRET=
# BOBSLED_OPERATOR_AUTH_MODE=github
# BOBSLED_GITHUB_CLIENT_ID=
# BOBSLED_GITHUB_CLIENT_SECRET=
# BOBSLED_SESSION_SECRET=
# BOBSLED_PUBLIC_ORIGIN=https://bobsled.example.com
